FROM node:22-bookworm-slim AS node-tools

FROM rust:1.91-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 bash \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install wasm-pack --version 0.15.0 --locked
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
RUN rustup component add rustfmt

WORKDIR /workspace
COPY . .
COPY ci/run.sh /usr/local/bin/qr-light-ci
RUN chmod +x /usr/local/bin/qr-light-ci helpers/shell/*.sh helpers/python/*.py

ENTRYPOINT ["/usr/local/bin/qr-light-ci"]
